{
  "name": "atrium",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev",
    "dev:cert": "WATCHPACK_POLLING=true NODE_EXTRA_CA_CERTS=$PWD/certs/watt-toolkit.pem next dev",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "start:cert": "NODE_EXTRA_CA_CERTS=$PWD/certs/watt-toolkit.pem node scripts/start.mjs",
    "desktop": "electron electron/main.js",
    "desktop:cert": "NODE_EXTRA_CA_CERTS=$PWD/certs/watt-toolkit.pem electron electron/main.js",
    "desktop:smoke": "NODE_EXTRA_CA_CERTS=$PWD/certs/watt-toolkit.pem ATRIUM_SMOKE=1 electron electron/main.js",
    "typecheck": "tsc --noEmit"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "^44.3.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "unified": "^11.0.5"
  }
}
