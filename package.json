{
  "name": "atrium",
  "version": "1.2.14",
  "private": true,
  "description": "中庭 · 个人数字空间：书房 / 画廊 / 工具房 / 陈列廊，GitHub 即数据库",
  "license": "MIT",
  "scripts": {
    "dev": "ulimit -n 10240; ATRIUM_ALLOW_WRITE=1 WATCHPACK_POLLING=true next dev",
    "dev:cert": "ulimit -n 10240; ATRIUM_ALLOW_WRITE=1 WATCHPACK_POLLING=true NODE_EXTRA_CA_CERTS=$PWD/certs/watt-toolkit.pem next dev",
    "build": "next build",
    "start": "ulimit -n 10240; node scripts/start.mjs",
    "start:cert": "ulimit -n 10240; NODE_EXTRA_CA_CERTS=$PWD/certs/watt-toolkit.pem node scripts/start.mjs",
    "desktop": "electron electron-app/main.js",
    "desktop:cert": "ulimit -n 10240; NODE_EXTRA_CA_CERTS=$PWD/certs/watt-toolkit.pem electron electron-app/main.js",
    "desktop:smoke": "ulimit -n 10240; NODE_EXTRA_CA_CERTS=$PWD/certs/watt-toolkit.pem ATRIUM_SMOKE=1 electron electron-app/main.js",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:pack": "next build && node scripts/prepare-desktop.mjs && electron-builder --mac --dir",
    "desktop:dist": "next build && node scripts/prepare-desktop.mjs && electron-builder --mac",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "postinstall": "node scripts/ensure-electron.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "^44.3.0",
    "electron-builder": "26.15.3",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "unified": "^11.0.5"
  }
}
